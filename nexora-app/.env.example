APP_NAME=Nexora
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://nexora.loc

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Для локальной отладки можно временно включить: APP_DEBUG=true

SEO_DEFAULT_TITLE="Nexora — создание сайтов и веб-разработка"
SEO_DEFAULT_DESCRIPTION="Nexora — разработка и сопровождение веб-проектов под ключ. Современные сайты, порталы и автоматизация бизнес-процессов."

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nexora_db
DB_USERNAME=root
DB_PASSWORD=

# В production задайте надёжный пароль (не root/root).

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Домены SPA для Sanctum (CSRF на POST /api/*). Через запятую.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,127.0.0.1,nexora.loc

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@nexora.by"
MAIL_FROM_NAME="${APP_NAME}"

ORDER_NOTIFICATION_EMAIL="hello@nexora.by"

# API-интеграции (предпочтительно настраивать в Nova → Система → API-интеграции)
# Fallback для Яндекс.Вебмастера, если не задано в админке:
YANDEX_WEBMASTER_ENABLED=false
YANDEX_WEBMASTER_OAUTH_TOKEN=
YANDEX_WEBMASTER_HOST_ID=
YANDEX_WEBMASTER_SITE_URL="${APP_URL}"
YANDEX_WEBMASTER_CACHE_TTL=3600

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
